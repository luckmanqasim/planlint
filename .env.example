# --- LLM access (bring your own key; pick ONE provider or several) -----------
# Set the API key for your chosen provider. Defaults use Google Gemini.
# PlanLint uses Pydantic AI, which supports Google, OpenAI, Anthropic, and others.
# For additional providers, install the matching extra: pip install 'pydantic-ai-slim[mistral]'
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Any Pydantic AI model string works here:
#   google:gemini-3.6-flash | openai:gpt-5.6 | anthropic:claude-sonnet-5 ...
# The vision model must support image input. A stronger/pro-tier vision model
# detects hatched wall piers and garage doors more reliably than a flash model.
PLANLINT_VISION_MODEL=google:gemini-3.6-flash
PLANLINT_TEXT_MODEL=google:gemini-3.6-flash

# --- Options ------------------------------------------------------------------
# auto = LLM-first: the vision model transcribes codebook pages when a matching
# API key is set (one-time cost per codebook — cached in the graph), else Docling
# when installed (pip install 'planlint[docling]'), else the simple text parser.
PLANLINT_SEMANTIC_PARSER=auto

# Offline sample mode: swaps LLM calls for deterministic label/regex extraction
# so the bundled sample runs with zero API cost and no key. The bundled sample
# only — real or scanned drawings need a vision key, so leave this 0 for them.
PLANLINT_OFFLINE_SAMPLE=0

# --- Neo4j --------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local-dev default — change this for any networked or production deployment.
NEO4J_PASSWORD=planlint123
