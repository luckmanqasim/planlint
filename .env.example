# --- LLM access (bring your own key; pick ONE provider or several) -----------
# Default models are Gemini; set the matching key.
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Any Pydantic AI model string works here:
#   google:gemini-3-flash-preview | openai:gpt-5.2 | anthropic:claude-sonnet-5 ...
PLANLINT_VISION_MODEL=google:gemini-3.5-flash
PLANLINT_TEXT_MODEL=google:gemini-3.5-flash

# --- Neo4j --------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=planlint123

# --- Options ------------------------------------------------------------------
# auto = use Docling when installed (pip install 'planlint[docling]'), else the
# built-in simple parser (fine for clean text PDFs like the bundled sample).
PLANLINT_SEMANTIC_PARSER=auto

# Dev/demo only: replaces all LLM calls with deterministic fakes so the bundled
# sample runs offline with zero API cost. Never use with real projects.
PLANLINT_FAKE_LLM=0
